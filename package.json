{
  "name": "@gsomenzi/nodejs-telemetry",
  "version": "0.1.1",
  "author": "Guilherme Somenzi <somenziguilherme@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/gsomenzi/nodejs-telemetry.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs/index.d.ts",
        "default": "./dist/nestjs/index.js"
      },
      "require": {
        "types": "./dist/nestjs/index.d.cts",
        "default": "./dist/nestjs/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "prepare": "tsup",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "bump": "./scripts/bump-version.sh"
  },
  "dependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.21",
    "@nestjs/core": "^11.1.24",
    "@nestjs/testing": "^11.1.24",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "jest": "^30.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.10",
    "ts-node": "^10.9.2"
  }
}
